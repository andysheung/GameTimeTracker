rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone with the link can read the squad, live game and history.
    // Only the coach's Google account can change anything.
    // Replace COACH_EMAIL with the Gmail address you sign in with.
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email_verified == true
                   && request.auth.token.email == "COACH_EMAIL";
    }
  }
}
